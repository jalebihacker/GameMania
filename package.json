{
  "name": "party-game-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "start": "npm --prefix server start",
    "install:all": "npm install --include=dev && npm --prefix server install --include=dev && npm --prefix client install --include=dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
